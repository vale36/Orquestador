# Modo fijo (opcional): requerido solo si CONSUL_ENABLED=false.
VALIDACION_URL=
EXTRACCION_URL=
PERSISTENCIA_CONSULTAS_URL=
PERSISTENCIA_ACTUALIZACIONES_URL=

# Service discovery. Fallback deshabilitado por defecto.
CONSUL_ENABLED=true
CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_HTTP_TOKEN_FILE=/run/secrets/consul_orchestrator_token
CONSUL_FALLBACK_ENABLED=false
# Registro propio (contrato 1.6.0); los tags son las reglas de Traefik, en JSON.
CONSUL_SERVICE_ADDRESS=
CONSUL_SERVICE_PORT=8000
CONSUL_SERVICE_TAGS=[]

REQUEST_TIMEOUT_SECONDS=
RETRY_ATTEMPTS=
RETRY_DELAY_SECONDS=
LOG_LEVEL=INFO
# Opcional (contrato 1.7.0): el mismo valor que en validacion-pdf. Corta antes los
# bodies demasiado grandes; la regla del tamaño la aplica validación.
PDF_MAX_SIZE_MB=5

# Solo para docker compose: carpeta con los tokens que genera el bootstrap de Consul.
# Por defecto ../dockers/consul/generated (repos clonados uno al lado del otro).
# CONSUL_TOKENS_DIR=../dockers/consul/generated
